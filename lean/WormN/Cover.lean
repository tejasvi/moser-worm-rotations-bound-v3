import WormN.AllUnits

/-! The skeleton of every part is well formed, and the chunks list every unit, in order
(generated by tools/wshards.py). -/

namespace WormN

open WormCore

/-- The skeleton walk of every part succeeds. -/
theorem skel_ok : (List.range rootW.nparts).all (fun p => (unitBoxes rootW p (skelOf p)).isSome) = true := by
  native_decide

/-- The chunks list every unit, in order. -/
theorem cover : allUnits = unitLists.flatten := by
  native_decide

end WormN
