/-! The skeletons of all 16384 parts (generated by tools/wshards.py). -/

namespace WormN

/-- The skeleton groups, 256 parts each. -/
def skelGroups : Array (Array String) := #[
  skelG000, skelG001, skelG002, skelG003, skelG004, skelG005, skelG006, skelG007, skelG008, skelG009, skelG010,
  skelG011, skelG012, skelG013, skelG014, skelG015, skelG016, skelG017, skelG018, skelG019, skelG020, skelG021,
  skelG022, skelG023, skelG024, skelG025, skelG026, skelG027, skelG028, skelG029, skelG030, skelG031, skelG032,
  skelG033, skelG034, skelG035, skelG036, skelG037, skelG038, skelG039, skelG040, skelG041, skelG042, skelG043,
  skelG044, skelG045, skelG046, skelG047, skelG048, skelG049, skelG050, skelG051, skelG052, skelG053, skelG054,
  skelG055, skelG056, skelG057, skelG058, skelG059, skelG060, skelG061, skelG062, skelG063]

/-- The skeleton of part `p` (`""` if `p` is out of range). -/
def skelOf (p : Nat) : String := (skelGroups.getD (p / 256) #[]).getD (p % 256) ""

end WormN
