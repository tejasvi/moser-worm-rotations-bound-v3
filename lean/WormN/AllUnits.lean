/-! The list of all units, from the skeletons, and the unit lists of all chunks in chunk order
(generated by tools/wshards.py). -/

namespace WormN

open WormCore

/-- Every unit `(p, u)` of every part `p < rootW.nparts`, `u` ascending. -/
def allUnits : List (Nat × Nat) :=
  (List.range rootW.nparts).flatMap fun p =>
    (List.range ((unitBoxes rootW p (skelOf p)).getD #[]).size).map (p, ·)

/-- The unit lists of the 6688 chunks, in chunk order. -/
def unitLists : List (List (Nat × Nat)) :=
  unitsG_000 ++ unitsG_001 ++ unitsG_002 ++ unitsG_003 ++ unitsG_004 ++ unitsG_005 ++ unitsG_006 ++ unitsG_007 ++
